// The Buffet Battle API: a Cloudflare Worker with a D1 database (DESIGN.md, "Async multiplayer and the backend").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buffet-battle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "a5efc761e677570420b934bb2e955d89",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buffet-battle",
      "database_id": "178d21f5-dced-4968-a7a3-966b73eefc3f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Sites allowed to call the API from a browser, besides localhost.
    "ALLOWED_ORIGINS": "https://ericx1e.github.io"
  }
}
