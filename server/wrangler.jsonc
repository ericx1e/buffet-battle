// The Buffet Battle API: a Cloudflare Worker with a D1 database (DESIGN.md, "Async multiplayer and the backend").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buffet-battle-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "account_id": "a5efc761e677570420b934bb2e955d89",
  "observability": { "enabled": true },
  // api.buffetbattle.com, and the original workers.dev address, which keeps working.
  "routes": [{ "pattern": "api.buffetbattle.com", "custom_domain": true }],
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "buffet-battle",
      "database_id": "178d21f5-dced-4968-a7a3-966b73eefc3f",
      "migrations_dir": "migrations"
    }
  ],
  // Requests per minute: 60 for each player, and 3 new players for each address (simple limits: 10 or 60 s periods).
  "ratelimits": [
    { "name": "PLAYER_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "SIGNUP_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": {
    // Sites allowed to call the API from a browser, besides localhost (app://buffetbattle: the desktop app).
    "ALLOWED_ORIGINS": "https://buffetbattle.com,https://www.buffetbattle.com,https://ericx1e.github.io,app://buffetbattle"
  }
}
